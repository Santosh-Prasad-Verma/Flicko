# Caddyfile configuration for LiveKit Production Setup
# Replace "livekit.yourdomain.com" and "turn.yourdomain.com" with your actual subdomains.

livekit.yourdomain.com {
    # Reverse proxy signaling traffic (HTTP & WebSockets) to the LiveKit server container
    reverse_proxy livekit:7880
}

turn.yourdomain.com {
    # Dummy handler so Caddy initiates ACME challenge and provisions certificates
    # for the TURN domain. LiveKit server will read these certificates directly
    # from the shared Docker volume.
    respond "TURN Server TLS Endpoint" 200
}
