# =============================================================================
# Flicko — Message Service Production Dockerfile
# =============================================================================
#
# Multi-stage build producing a minimal static binary.
# Build context MUST be `services/` (not msg-service/) because go.mod uses
# `replace ../shared` to reference the shared module.
#
# Build:
#   docker build -f services/msg-service/Dockerfile.prod \
#                -t flicko/msg-service:latest ./services
#
# Or via docker-compose.prod.yml (sets context: ./services automatically).
#
# Final image: alpine:3.22 + static binary + CA certs ≈ 15–18 MB.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: BUILD — compile a fully static Go binary
# ─────────────────────────────────────────────────────────────────────────────
# NOTE: go.mod requires `go 1.25.7`. Using golang:1.25-alpine to satisfy.
# golang:1.22-alpine would fail with "go: go.mod requires go >= 1.25.7".
FROM golang:1.25-alpine AS build

# ca-certificates: needed at build time if modules are fetched over HTTPS.
# git: required by `go mod download` for any VCS-based dependencies.
# tzdata: timezone data copied to runtime stage for correct log timestamps.
RUN apk add --no-cache ca-certificates git tzdata

# ── Dependency layer (cached unless go.mod/go.sum change) ───────────────
# Copy go.mod + go.sum for both shared and msg-service first.
# Docker will cache the `go mod download` layer until these files change,
# which means code-only changes rebuild only the binary, not deps.
WORKDIR /src

# Shared module — msg-service depends on this via `replace ../shared`
COPY shared/go.mod shared/go.sum ./shared/

# Message service module
COPY msg-service/go.mod msg-service/go.sum ./msg-service/

WORKDIR /src/msg-service
RUN go mod download && go mod verify

# ── Source copy + compile ───────────────────────────────────────────────
# Now copy the actual source code. This layer rebuilds on every code change,
# but the expensive dependency download above is cached.
WORKDIR /src
COPY shared/ ./shared/
COPY msg-service/ ./msg-service/

WORKDIR /src/msg-service

# CGO_ENABLED=0 — pure Go, no C dependencies. Produces a static binary
#   that doesn't link against libc, so it runs on scratch/alpine without
#   any shared libraries. Note: pgx (PostgreSQL driver) works without CGO.
# -trimpath — remove filesystem paths from the binary (reproducible builds,
#   doesn't leak server directory structure in stack traces).
# -ldflags="-s -w" — strip debug symbols and DWARF info.
#   -s: omit symbol table → saves ~2 MB
#   -w: omit DWARF debug info → saves ~1 MB
# -tags=netgo — use Go's native DNS resolver instead of CGO's.
# Result: ~12–15 MB fully static binary (larger than gateway due to pgx).
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -trimpath \
    -tags=netgo \
    -ldflags="-s -w -extldflags '-static'" \
    -o /bin/msg-service ./cmd/server


# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: RUNTIME — minimal Alpine with just the binary
# ─────────────────────────────────────────────────────────────────────────────
# Why alpine:3.22 and not scratch?
#   - We need wget for HEALTHCHECK (scratch has no shell/tools).
#   - We need ca-certificates for outbound TLS (PostgreSQL).
#   - alpine:3.22 base is ~3.3 MB, total image stays under 20 MB.
FROM alpine:3.22

# Install only what's strictly needed:
#   ca-certificates — TLS cert bundle for outbound HTTPS (PostgreSQL)
#   tzdata          — timezone database (for UTC log timestamps)
#   wget            — HEALTHCHECK probe (lighter than curl, no libcurl deps)
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates tzdata wget

# ── Non-root user ───────────────────────────────────────────────────────
# Create a dedicated non-root user. NEVER run production containers as root.
# UID 1000 — conventional first non-system user, avoids conflicts with
# system UIDs (0–999) and is compatible with most Kubernetes pod security
# policies and Docker rootless mode.
RUN addgroup -g 1000 -S appuser && \
    adduser -u 1000 -S -G appuser -h /app -s /sbin/nologin appuser

# ── Dead-letter queue directory ─────────────────────────────────────────
# The batcher writes failed message batches here as JSONL files for retry.
# Must exist and be writable by appuser before the binary starts.
RUN mkdir -p /data/dead_letter && chown -R appuser:appuser /data

# ── Application directory ───────────────────────────────────────────────
WORKDIR /app

# Copy the static binary from the build stage.
COPY --from=build /bin/msg-service /app/msg-service

# Ensure the binary is owned by appuser and executable.
RUN chown appuser:appuser /app/msg-service && chmod 755 /app/msg-service

# ── Drop to non-root ───────────────────────────────────────────────────
USER appuser

# ── Ports ───────────────────────────────────────────────────────────────
# 8081 — HTTP REST API + /healthz
# 9101 — Prometheus /metrics (scraped by Prometheus on flicko_monitor network)
EXPOSE 8081 9101

# ── Health Check ────────────────────────────────────────────────────────
# Docker daemon probes this every 10s. After 5 consecutive failures
# (50s total), the container is marked unhealthy and compose can restart it.
# --start-period gives the binary 15s to boot (longer than gateway because
# msg-service establishes DB + Redis connections on startup).
# wget --spider does a HEAD-like request (no body download).
HEALTHCHECK --interval=10s --timeout=3s --retries=5 --start-period=15s \
    CMD ["wget", "--spider", "-q", "http://localhost:8081/healthz"]

# ── Entrypoint ──────────────────────────────────────────────────────────
# Exec form (JSON array) — the binary runs as PID 1, receives signals
# directly (SIGTERM for graceful shutdown), no shell wrapper overhead.
ENTRYPOINT ["/app/msg-service"]
