{
  "name": "flicko",
  "version": "1.0.0",
  "private": true,
  "description": "Flicko — Discord-inspired mobile communication platform",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'",
    "format:check": "prettier --check '**/*.{ts,tsx,js,jsx,json,md,yml,yaml}'"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.go": [
      "gofmt -w"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
