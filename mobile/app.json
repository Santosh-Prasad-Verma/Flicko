{
  "expo": {
    "name": "Flicko",
    "slug": "flicko",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Flicko_icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/Flicko_icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5865F2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flicko.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Flicko needs camera access to take photos and videos for sharing in messages",
        "NSPhotoLibraryUsageDescription": "Flicko needs photo library access to share images in messages",
        "NSMicrophoneUsageDescription": "Flicko needs microphone access for voice messages and voice/video calls",
        "NSFaceIDUsageDescription": "Flicko uses Face ID for secure and convenient authentication"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Flicko_icon.png",
        "backgroundColor": "#5865F2"
      },
      "package": "com.flicko.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/Flicko_icon.png",
          "color": "#5865F2"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flicko needs access to your photos to share images in messages"
        }
      ],
      "./plugins/withReanimatedFix.js"
    ],
    "scheme": "flicko",
    "web": {
      "favicon": "./assets/Flicko_icon.png"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "54bdaefd-6d9c-4680-ad46-cc731245489a"
      }
    },
    "owner": "tarun_121"
  }
}
