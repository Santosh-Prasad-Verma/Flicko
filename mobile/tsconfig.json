{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest"],
    "ignoreDeprecations": "5.0",
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "@constants/*": ["./constants/*"],
      "@shared/*": ["../shared/*"],
      "@services/*": ["../shared/services/*"],
      "@stores/*": ["../shared/stores/*"],
      "@hooks/*": ["../shared/hooks/*", "./hooks/*"],
      "@types/*": ["../shared/types/*"],
      "@utils/*": ["../shared/utils/*", "./utils/*"],
      "@lib/*": ["../shared/lib/*"]
    }
  }
}
