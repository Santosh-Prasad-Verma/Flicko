ENVIRONMENT=development

# Shared backend/services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_at_least_32_characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
ENCRYPTION_KEY=replace_with_64_hex_chars_generated_by_openssl_rand_hex_32

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=flickochat_media

# Mobile API base
FLICKO_API_URL=http://localhost:8080

# Voice (Supabase Edge function)
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Internal service-to-service auth token (shared between ws-gateway and msg-service)
# Generate with: openssl rand -hex 32
INTERNAL_GATEWAY_TOKEN=generate_with_openssl_rand_hex_32

# Sonic-Drip (uses JioSaavn + YouTube — no external service needed)