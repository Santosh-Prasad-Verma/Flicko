ENVIRONMENT=development

# Shared backend/services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_at_least_32_characters
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key
ENCRYPTION_KEY=replace_with_64_hex_chars_generated_by_openssl_rand_hex_32

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=flickochat_media

# Mobile API base
FLICKO_API_URL=http://localhost:8080

# Aura AI / Gemini
# For production mobile builds, prefer issuing short-lived Live API tokens from
# your backend instead of shipping a long-lived API key in the app bundle.
FLICKO_GEMINI_API_KEY=replace_with_google_ai_studio_key
FLICKO_GEMINI_TEXT_MODEL=gemini-2.5-flash
FLICKO_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Free WebRTC direct calls
# STUN is free and enough for many networks. Add TURN for strict NAT/firewall users.
FLICKO_RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
FLICKO_RTC_TURN_URL=turn:104.43.114.32:3479
FLICKO_RTC_TURN_USERNAME=flicko
FLICKO_RTC_TURN_CREDENTIAL=flickoSecretSecurePassword2026!

# Voice (Supabase Edge function)
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Internal service-to-service auth token (shared between ws-gateway and msg-service)
# Generate with: openssl rand -hex 32
INTERNAL_GATEWAY_TOKEN=generate_with_openssl_rand_hex_32

# Sonic-Drip (uses JioSaavn + YouTube — no external service needed)

# Feature Flags
FEATURE_ACTIVITIES_WATCH_TOGETHER=false
FEATURE_AI_MESSAGE_SUMMARY=false

# DataStax Astra DB (Cassandra-compatible — AI logs, audit trails, feed caches)
ASTRA_DB_ID=your_astra_database_id
ASTRA_DB_REGION=us-east-2
ASTRA_DB_KEYSPACE=flicko
ASTRA_DB_API_ENDPOINT=https://your-db-id-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:replace_with_token
