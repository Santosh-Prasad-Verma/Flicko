ENVIRONMENT=development

# Shared backend/services
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_at_least_32_characters
ENCRYPTION_KEY=replace_with_64_hex_chars_generated_by_openssl_rand_hex_32

# Azure Services
AZURE_POSTGRES_CONNECTION_STRING=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>?sslmode=require
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_WEBPUBSUB_CONNECTION_STRING=Endpoint=https://<pubsub-name>.webpubsub.azure.com;AccessKey=<key>;Version=1.0;
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://<comm-name>.communication.azure.com/;accesskey=<key>
AZURE_COMMUNICATION_ENDPOINT=https://<comm-name>.communication.azure.com

# Mobile API base
FLICKO_API_URL=http://localhost:8080

# Azure Push Notifications
AZURE_NOTIFICATION_HUB_CONNECTION_STRING=Endpoint=sb://<hub-namespace>.servicebus.windows.net/;SharedAccessKeyName=DefaultFullSharedAccessSignature;SharedAccessKey=<key>

# Aura AI Assistant (Gemini + Deepgram Voice + Web Search)
FLICKO_GEMINI_API_KEY=replace_with_google_ai_studio_key
FLICKO_GEMINI_TEXT_MODEL=gemini-2.5-flash
FLICKO_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
FLICKO_DEEPGRAM_API_KEY=replace_with_deepgram_key
FLICKO_TAVILY_API_KEY=replace_with_tavily_key
FLICKO_SERPER_API_KEY=replace_with_serper_key

# Appwrite Secondary Storage
FLICKO_APPWRITE_PROJECT_ID=your_appwrite_project_id
FLICKO_APPWRITE_PUBLIC_ENDPOINT=https://cloud.appwrite.io/v1
FLICKO_APPWRITE_BUCKET_ID=your_appwrite_bucket_id

# Internal service-to-service auth token
INTERNAL_GATEWAY_TOKEN=generate_with_openssl_rand_hex_32

# Feature Flags
FEATURE_ACTIVITIES_WATCH_TOGETHER=true
FEATURE_AI_MESSAGE_SUMMARY=true

# DataStax Astra DB (NoSQL)
ASTRA_DB_ID=your_astra_database_id
ASTRA_DB_REGION=us-east-2
ASTRA_DB_KEYSPACE=flicko
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:<token>
