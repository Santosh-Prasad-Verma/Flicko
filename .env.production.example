# =============================================================================
# Flicko — Production Environment Variables
# =============================================================================
#
# This file contains ONLY the variables required by docker-compose.prod.yml.
# For full setup instructions, see Documentation/ENV-SETUP.md.
#
# Setup:
#   1. cp .env.production.example .env
#   2. Fill in every value below
#   3. Ensure this file is in .gitignore (NEVER commit secrets)
#
# Generate secrets:
#   openssl rand -base64 32    → GRAFANA_ADMIN_PASSWORD, BACKUP_PASSPHRASE
#
# Generate JWT keys:
#   scripts/generate-jwt-keys.sh
#
# =============================================================================

# ── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=production
DOMAIN=flicko.dev

# ── PostgreSQL (Azure Managed / Self-Hosted) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/flickodb?sslmode=require

# ── Redis (Self-Hosted) ──────────────────────────────────────────────────────
# Connects to the local Redis container in docker-compose.prod.yml.
# For services inside the Docker Compose network, use: redis://redis:6379
REDIS_URL=redis://redis:6379

# ── Cloudinary (Media Storage) ───────────────────────────────────────────────
# From: Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Grafana ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=PASTE_YOUR_GENERATED_PASSWORD_HERE

# Aura AI / Gemini
# Production note: direct mobile API keys are easy to extract. Use this only
# for trusted/internal builds, or replace it with backend-issued ephemeral
# Live API tokens before public release.
FLICKO_GEMINI_API_KEY=PASTE_GOOGLE_AI_STUDIO_KEY_HERE
FLICKO_GEMINI_TEXT_MODEL=gemini-2.5-flash
FLICKO_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Free WebRTC direct calls. Keep TURN optional; STUN is free, TURN costs bandwidth.
FLICKO_RTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
FLICKO_RTC_TURN_URL=
FLICKO_RTC_TURN_USERNAME=
FLICKO_RTC_TURN_CREDENTIAL=

# Feature Flags
FEATURE_ACTIVITIES_WATCH_TOGETHER=false
FEATURE_AI_MESSAGE_SUMMARY=false

