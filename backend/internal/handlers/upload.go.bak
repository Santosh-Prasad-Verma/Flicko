package handlers

import (
	"encoding/json"
	"fmt"
	"net/http"

	"github.com/flicko-org/flicko-backend/internal/database"
	"github.com/flicko-org/flicko-backend/internal/middleware"
	"github.com/flicko-org/flicko-backend/internal/storage"
	"github.com/gorilla/mux"
	"go.uber.org/zap"
)

// UploadHandler manages all file upload/delete HTTP endpoints.
type UploadHandler struct {
	storage *storage.B2Client
	db      database.DatabaseClient
	logger  *zap.Logger
}

// NewUploadHandler creates an UploadHandler wired to B2 storage and the database.
func NewUploadHandler(b2Client *storage.B2Client, db database.DatabaseClient, logger *zap.Logger) *UploadHandler {
	return &UploadHandler{
		storage: b2Client,
		db:      db,
		logger:  logger,
	}
}

func writeJSON(w http.ResponseWriter, code int, v interface{}) {
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(code)
	json.NewEncoder(w).Encode(v)
}

func writeError(w http.ResponseWriter, code int, msg string) {
	writeJSON(w, code, map[string]string{"error": msg})
}

func getUserID(r *http.Request) string {
	if uid, ok := r.Context().Value(middleware.GetUserIDKey()).(string); ok {
		return uid
	}
	return ""
}

// UploadAvatar handles POST /api/v1/upload/avatar
func (h *UploadHandler) UploadAvatar(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	file, header, err := r.FormFile("file")
	if err != nil {
		writeError(w, http.StatusBadRequest, "missing file field")
		return
	}
	defer file.Close()

	url, err := h.storage.UploadAvatar(r.Context(), userID, file, header.Size, header.Header.Get("Content-Type"))
	if err != nil {
		h.logger.Error("upload avatar failed", zap.Error(err))
		writeError(w, http.StatusBadRequest, err.Error())
		return
	}

	_, dbErr := h.db.Exec(r.Context(),
		`UPDATE profiles SET avatar = $1 WHERE id = $2`, url, userID)
	if dbErr != nil {
		h.logger.Error("update profile avatar", zap.Error(dbErr))
	}

	writeJSON(w, http.StatusOK, map[string]string{"url": url})
}

// DeleteAvatar handles DELETE /api/v1/upload/avatar
func (h *UploadHandler) DeleteAvatar(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	if err := h.storage.DeleteAvatar(r.Context(), userID); err != nil {
		h.logger.Error("delete avatar failed", zap.Error(err))
		writeError(w, http.StatusInternalServerError, "failed to delete avatar")
		return
	}

	_, _ = h.db.Exec(r.Context(),
		`UPDATE profiles SET avatar = NULL WHERE id = $1`, userID)

	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

// UploadAttachment handles POST /api/v1/upload/attachment/{channelId}
func (h *UploadHandler) UploadAttachment(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	channelID := mux.Vars(r)["channelId"]
	if channelID == "" {
		writeError(w, http.StatusBadRequest, "missing channelId")
		return
	}

	file, header, err := r.FormFile("file")
	if err != nil {
		writeError(w, http.StatusBadRequest, "missing file field")
		return
	}
	defer file.Close()

	contentType := header.Header.Get("Content-Type")
	url, objectName, err := h.storage.UploadAttachment(r.Context(), channelID, header.Filename, file, header.Size, contentType)
	if err != nil {
		h.logger.Error("upload attachment failed", zap.Error(err))
		writeError(w, http.StatusBadRequest, err.Error())
		return
	}

	presignedURL, presignErr := h.storage.GeneratePresignedURL(r.Context(), storage.BucketAttachments, objectName, storage.PresignedURLExpiry)
	if presignErr != nil {
		h.logger.Warn("presign failed, using direct url", zap.Error(presignErr))
		presignedURL = url
	}

	writeJSON(w, http.StatusOK, map[string]interface{}{
		"url":          presignedURL,
		"object_name":  objectName,
		"filename":     header.Filename,
		"size":         header.Size,
		"content_type": contentType,
	})
}

// GetAttachmentURL handles GET /api/v1/upload/attachment/url?object_name=...
func (h *UploadHandler) GetAttachmentURL(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	objectName := r.URL.Query().Get("object_name")
	if objectName == "" {
		writeError(w, http.StatusBadRequest, "missing object_name query parameter")
		return
	}

	presignedURL, err := h.storage.GeneratePresignedURL(r.Context(), storage.BucketAttachments, objectName, storage.PresignedURLExpiry)
	if err != nil {
		h.logger.Error("get attachment url failed", zap.Error(err))
		writeError(w, http.StatusInternalServerError, "failed to generate URL")
		return
	}

	writeJSON(w, http.StatusOK, map[string]string{"url": presignedURL})
}

// DeleteAttachment handles DELETE /api/v1/upload/attachment
func (h *UploadHandler) DeleteAttachment(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	var body struct {
		ObjectName string `json:"object_name"`
	}
	if err := json.NewDecoder(r.Body).Decode(&body); err != nil || body.ObjectName == "" {
		writeError(w, http.StatusBadRequest, "missing object_name in body")
		return
	}

	if err := h.storage.DeleteAttachment(r.Context(), body.ObjectName); err != nil {
		h.logger.Error("delete attachment failed", zap.Error(err))
		writeError(w, http.StatusInternalServerError, "failed to delete attachment")
		return
	}

	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

// UploadServerIcon handles POST /api/v1/upload/server-icon/{serverId}
func (h *UploadHandler) UploadServerIcon(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	serverID := mux.Vars(r)["serverId"]
	if serverID == "" {
		writeError(w, http.StatusBadRequest, "missing serverId")
		return
	}

	if err := h.checkServerAdmin(r, userID, serverID); err != nil {
		writeError(w, http.StatusForbidden, "not a server owner or admin")
		return
	}

	file, header, err := r.FormFile("file")
	if err != nil {
		writeError(w, http.StatusBadRequest, "missing file field")
		return
	}
	defer file.Close()

	url, err := h.storage.UploadServerIcon(r.Context(), serverID, file, header.Size, header.Header.Get("Content-Type"))
	if err != nil {
		h.logger.Error("upload server icon failed", zap.Error(err))
		writeError(w, http.StatusBadRequest, err.Error())
		return
	}

	_, dbErr := h.db.Exec(r.Context(),
		`UPDATE servers SET icon = $1 WHERE id = $2`, url, serverID)
	if dbErr != nil {
		h.logger.Error("update servers icon", zap.Error(dbErr))
	}

	writeJSON(w, http.StatusOK, map[string]string{"url": url})
}

// DeleteServerIcon handles DELETE /api/v1/upload/server-icon/{serverId}
func (h *UploadHandler) DeleteServerIcon(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	serverID := mux.Vars(r)["serverId"]
	if err := h.checkServerAdmin(r, userID, serverID); err != nil {
		writeError(w, http.StatusForbidden, "not a server owner or admin")
		return
	}

	if err := h.storage.DeleteServerIcon(r.Context(), serverID); err != nil {
		h.logger.Error("delete server icon failed", zap.Error(err))
		writeError(w, http.StatusInternalServerError, "failed to delete icon")
		return
	}

	_, _ = h.db.Exec(r.Context(),
		`UPDATE servers SET icon = NULL WHERE id = $1`, serverID)

	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

// UploadEmoji handles POST /api/v1/upload/emoji/{serverId}
func (h *UploadHandler) UploadEmoji(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	serverID := mux.Vars(r)["serverId"]
	if serverID == "" {
		writeError(w, http.StatusBadRequest, "missing serverId")
		return
	}

	if err := h.checkServerAdmin(r, userID, serverID); err != nil {
		writeError(w, http.StatusForbidden, "not a server owner or admin")
		return
	}

	if err := r.ParseMultipartForm(storage.MaxEmojiSize + 1024); err != nil {
		writeError(w, http.StatusBadRequest, "invalid form data")
		return
	}

	emojiName := r.FormValue("emoji_name")
	if emojiName == "" {
		writeError(w, http.StatusBadRequest, "missing emoji_name field")
		return
	}

	file, header, err := r.FormFile("file")
	if err != nil {
		writeError(w, http.StatusBadRequest, "missing file field")
		return
	}
	defer file.Close()

	url, err := h.storage.UploadEmoji(r.Context(), serverID, emojiName, file, header.Size, header.Header.Get("Content-Type"))
	if err != nil {
		h.logger.Error("upload emoji failed", zap.Error(err))
		writeError(w, http.StatusBadRequest, err.Error())
		return
	}

	ext := "png"
	ct := header.Header.Get("Content-Type")
	if ct == "image/gif" {
		ext = "gif"
	} else if ct == "image/webp" {
		ext = "webp"
	}
	objectName := serverID + "/" + emojiName + "." + ext

	_, dbErr := h.db.Exec(r.Context(),
		`INSERT INTO server_emojis (server_id, name, url, object_name, created_by)
		 VALUES ($1, $2, $3, $4, $5)
		 ON CONFLICT (server_id, name) DO UPDATE SET url = $3, object_name = $4`,
		serverID, emojiName, url, objectName, userID)
	if dbErr != nil {
		h.logger.Error("insert server_emoji", zap.Error(dbErr))
	}

	writeJSON(w, http.StatusOK, map[string]string{"url": url, "name": emojiName})
}

// DeleteEmoji handles DELETE /api/v1/upload/emoji/{serverId}/{emojiName}
func (h *UploadHandler) DeleteEmoji(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	vars := mux.Vars(r)
	serverID := vars["serverId"]
	emojiName := vars["emojiName"]

	if err := h.checkServerAdmin(r, userID, serverID); err != nil {
		writeError(w, http.StatusForbidden, "not a server owner or admin")
		return
	}

	if err := h.storage.DeleteEmoji(r.Context(), serverID, emojiName); err != nil {
		h.logger.Error("delete emoji failed", zap.Error(err))
		writeError(w, http.StatusInternalServerError, "failed to delete emoji")
		return
	}

	_, _ = h.db.Exec(r.Context(),
		`DELETE FROM server_emojis WHERE server_id = $1 AND name = $2`, serverID, emojiName)

	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

// UploadBanner handles POST /api/v1/upload/banner/{ownerType}/{ownerId}
func (h *UploadHandler) UploadBanner(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	vars := mux.Vars(r)
	ownerType := vars["ownerType"]
	ownerID := vars["ownerId"]

	if ownerType == "user" && ownerID != userID {
		writeError(w, http.StatusForbidden, "cannot set another user's banner")
		return
	}
	if ownerType == "server" {
		if err := h.checkServerAdmin(r, userID, ownerID); err != nil {
			writeError(w, http.StatusForbidden, "not a server owner or admin")
			return
		}
	}

	file, header, err := r.FormFile("file")
	if err != nil {
		writeError(w, http.StatusBadRequest, "missing file field")
		return
	}
	defer file.Close()

	url, err := h.storage.UploadBanner(r.Context(), ownerType, ownerID, file, header.Size, header.Header.Get("Content-Type"))
	if err != nil {
		h.logger.Error("upload banner failed", zap.Error(err))
		writeError(w, http.StatusBadRequest, err.Error())
		return
	}

	if ownerType == "user" {
		_, _ = h.db.Exec(r.Context(),
			`UPDATE profiles SET banner = $1 WHERE id = $2`, url, ownerID)
	} else {
		_, _ = h.db.Exec(r.Context(),
			`UPDATE servers SET banner = $1 WHERE id = $2`, url, ownerID)
	}

	writeJSON(w, http.StatusOK, map[string]string{"url": url})
}

// DeleteBanner handles DELETE /api/v1/upload/banner/{ownerType}/{ownerId}
func (h *UploadHandler) DeleteBanner(w http.ResponseWriter, r *http.Request) {
	userID := getUserID(r)
	if userID == "" {
		writeError(w, http.StatusUnauthorized, "unauthorized")
		return
	}

	vars := mux.Vars(r)
	ownerType := vars["ownerType"]
	ownerID := vars["ownerId"]

	if ownerType == "user" && ownerID != userID {
		writeError(w, http.StatusForbidden, "cannot delete another user's banner")
		return
	}
	if ownerType == "server" {
		if err := h.checkServerAdmin(r, userID, ownerID); err != nil {
			writeError(w, http.StatusForbidden, "not a server owner or admin")
			return
		}
	}

	if err := h.storage.DeleteBanner(r.Context(), ownerType, ownerID); err != nil {
		h.logger.Error("delete banner failed", zap.Error(err))
		writeError(w, http.StatusInternalServerError, "failed to delete banner")
		return
	}

	if ownerType == "user" {
		_, _ = h.db.Exec(r.Context(),
			`UPDATE profiles SET banner = NULL WHERE id = $1`, ownerID)
	} else {
		_, _ = h.db.Exec(r.Context(),
			`UPDATE servers SET banner = NULL WHERE id = $1`, ownerID)
	}

	writeJSON(w, http.StatusOK, map[string]string{"status": "deleted"})
}

// checkServerAdmin verifies the user is the owner or admin of the given server.
func (h *UploadHandler) checkServerAdmin(r *http.Request, userID, serverID string) error {
	var ownerID string
	row := h.db.QueryRow(r.Context(),
		`SELECT owner_id FROM servers WHERE id = $1`, serverID)
	if err := row.Scan(&ownerID); err != nil {
		return err
	}
	if ownerID != userID {
		var hasAdmin bool
		row := h.db.QueryRow(r.Context(),
			`SELECT EXISTS(
				SELECT 1 FROM server_members sm
				JOIN member_roles mr ON mr.server_id = sm.server_id AND mr.user_id = sm.user_id
				JOIN roles rl ON rl.id = mr.role_id AND rl.server_id = sm.server_id
				WHERE sm.server_id = $1 AND sm.user_id = $2
				AND (rl.permissions & 8) = 8
			)`, serverID, userID)
		if err := row.Scan(&hasAdmin); err != nil {
			return err
		}
		if !hasAdmin {
			return fmt.Errorf("user %s is not owner or admin of server %s", userID, serverID)
		}
	}
	return nil
}
