# =============================================================================
# Mail Gateway Environment Variables
# =============================================================================
# Add these to your .env file in the project root

# ── SMTP Configuration (Gmail Example) ──────────────────────────────────────
# For Gmail:
#   1. Enable 2FA: https://myaccount.google.com/security
#   2. Generate App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character password below (remove spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password-here
SMTP_FROM=noreply@flicko.dev

# ── Webhook Secret ──────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# This MUST match the secret configured in Supabase Auth Hook

WEBHOOK_SECRET=your-random-secret-here

# ── Domain Configuration ────────────────────────────────────────────────────
DOMAIN=flicko.dev

# =============================================================================
# Supabase Auth Hook Configuration
# =============================================================================
# In Supabase Dashboard → Authentication → Hooks:
#
# 1. Create new hook:
#    - Name: flicko-mail-gateway
#    - Type: Send Email
#    - Enabled: ✅
#
# 2. HTTP Endpoint:
#    https://flicko.dev/mail/hooks/email
#
# 3. Events to trigger:
#    ✅ auth.signup
#    ✅ auth.recovery
#    ✅ auth.magiclink
#    ✅ auth.email_change
#    ✅ auth.reauthentication
#
# 4. Secrets:
#    Key: webhook_secret
#    Value: [same as WEBHOOK_SECRET above]
#
# 5. Timeout: 5000 ms
#
# =============================================================================
