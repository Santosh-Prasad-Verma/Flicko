{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "paths": {
      "zustand": ["../mobile/node_modules/zustand"],
      "zustand/*": ["../mobile/node_modules/zustand/*"],
      "expo-secure-store": ["../mobile/node_modules/expo-secure-store"],
      "expo-secure-store/*": ["../mobile/node_modules/expo-secure-store/*"],
      "@shared/*": ["./*"],
      "@services/*": ["./services/*"],
      "@stores/*": ["./stores/*"],
      "@hooks/*": ["./hooks/*"],
      "@types/*": ["./types/*"],
      "@utils/*": ["./utils/*"],
      "@lib/*": ["./lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
