/**
 * Backblaze B2 Storage Service
 * S3-compatible storage for avatars, banners, and attachments
 *
 * Replaces Supabase Storage with Backblaze B2 for:
 * - 10GB free storage (vs 1GB)
 * - Unlimited downloads (vs 2GB/month)
 * - Lower costs at scale
 *
 * Uses PutObjectCommand for reliability on React Native (avoids
 * multipart Upload class which has stream/polyfill issues).
 */
import { S3Client, PutObjectCommand, DeleteObjectCommand } from '@aws-sdk/client-s3';

// B2 Configuration — sourced from environment variables with hardcoded fallbacks
const B2_ENDPOINT = process.env.B2_ENDPOINT
  ? `https://${process.env.B2_ENDPOINT}`
  : 'https://s3.us-east-005.backblazeb2.com';
const B2_KEY_ID = process.env.B2_KEY_ID || '005d2035e5fff430000000001';
const B2_APPLICATION_KEY = process.env.B2_APPLICATION_KEY || 'K005J3n5SZWGUVi2dC5S4MkOysjaXJw';
const B2_BUCKET = process.env.B2_BUCKET_NAME || 'flickochat-media';
const B2_PUBLIC_URL = process.env.B2_PUBLIC_URL || 'https://f005.backblazeb2.com/file/flickochat-media';
const B2_REGION = process.env.B2_REGION || 'us-east-005';

// Initialize S3-compatible client for Backblaze B2
const s3Client = new S3Client({
  endpoint: B2_ENDPOINT,
  region: B2_REGION,
  credentials: {
    accessKeyId: B2_KEY_ID,
    secretAccessKey: B2_APPLICATION_KEY,
  },
  forcePathStyle: true, // Required for B2 S3-compatible API
});

/**
 * Upload file to B2 storage using PutObjectCommand (single PUT request).
 * More reliable on React Native than the multipart Upload class.
 *
 * @param path - File path in bucket (e.g., "avatars/user-123/avatar.gif")
 * @param buffer - File data as ArrayBuffer or Uint8Array
 * @param contentType - MIME type (e.g., "image/gif")
 * @returns Public URL of uploaded file
 */
export async function uploadToB2(
  path: string,
  buffer: ArrayBuffer | Uint8Array,
  contentType: string,
): Promise<string> {
  const body = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);

  const command = new PutObjectCommand({
    Bucket: B2_BUCKET,
    Key: path,
    Body: body,
    ContentType: contentType,
    CacheControl: 'public, max-age=31536000',
    ContentLength: body.byteLength,
  });

  try {
    await s3Client.send(command);
  } catch (err: any) {
    console.error('[B2] Upload failed:', path, err?.message || err);
    throw new Error(`B2 upload failed: ${err?.message || 'Unknown error'}`);
  }

  // Return public URL
  return `${B2_PUBLIC_URL}/${path}`;
}

/**
 * Delete file from B2 storage
 * @param path - File path in bucket
 */
export async function deleteFromB2(path: string): Promise<void> {
  const command = new DeleteObjectCommand({
    Bucket: B2_BUCKET,
    Key: path,
  });

  await s3Client.send(command);
}

/**
 * Get public URL for a file
 * @param path - File path in bucket
 * @returns Public URL
 */
export function getB2PublicUrl(path: string): string {
  return `${B2_PUBLIC_URL}/${path}`;
}

/**
 * Extract path from B2 URL
 * @param url - Full B2 URL
 * @returns Path in bucket, or null if not a B2 URL
 */
export function extractB2Path(url: string): string | null {
  const match = url.match(/file\/flickochat-media\/(.+)/);
  return match ? match[1] : null;
}
